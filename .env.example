# PostgreSQL (required, no defaults — fill in before running)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=promotions
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=3000
APP_TIMEZONE=America/Bogota
# Comma-separated CORS allowlist. Leave empty to disable CORS (the nginx proxy
# makes the frontend same-origin). Needed only for e.g. Vite dev server:
CORS_ORIGIN=http://localhost:5173

# Frontend
# Host port where the web app is served
FRONTEND_PORT=8080
# Base path the frontend uses to reach the API (nginx proxies /api -> backend)
VITE_API_URL=/api
